import Sqpack.Rect5
import Sqpack.Rect4Core

/-!
# Five squares in a strip: glue for `Final5`

Generic steps used by every case of `Final5` (`Rect5Final*.lean`, generated by
`search/rectfront/r5strip/hi5.py`): rational bounds for `√2`, the chain sum `chain5`, and `C > 0` in the
frontier branch of the one-square bound.
-/

namespace SquarePacking

lemma sqrt2_lo : (1414213 : ℝ) / 1000000 ≤ Real.sqrt 2 :=
  Real.le_sqrt_of_sq_le (by norm_num)

lemma sqrt2_hi : Real.sqrt 2 ≤ (707107 : ℝ) / 500000 := by
  rw [Real.sqrt_le_left (by norm_num)]; norm_num

/-- The chain: `b`'s bound, the middle square, `d`'s bound. -/
lemma chain5 {S₁ S₂ s₁ s₂ L B₁ B₂ M : ℝ} (hS₁ : 0 < S₁) (hS₂ : 0 < S₂) (h1 : B₁ ≤ s₁)
    (h2 : B₂ ≤ S₂ * L - s₂) (hm : M ≤ s₂ / S₂ - s₁ / S₁) : B₁ / S₁ + M + B₂ / S₂ ≤ L := by
  have a : B₁ / S₁ ≤ s₁ / S₁ := div_le_div_of_nonneg_right h1 hS₁.le
  have b : B₂ / S₂ ≤ L - s₂ / S₂ := by
    rw [div_le_iff₀ hS₂]; rw [sub_mul, div_mul_cancel₀ _ hS₂.ne']; linarith
  linarith

/-- The frontier branch needs `C > 0` (at `C = 0` it would say `2 - H ≤ 0`). -/
lemma psi_branch_pos {C S H X : ℝ} (hC : 0 ≤ C) (hCS : C ^ 2 + S ^ 2 = 1) (hS : 0 ≤ S) (hH : H < 2)
    (h : C * (S - C) + (1 + C + S - H) ≤ C * X) : 0 < C := by
  rcases eq_or_lt_of_le hC with h0 | h0
  · subst h0; have : S = 1 := by nlinarith
    subst this; linarith
  · exact h0

/-- The frontier branch as a bound on `X`. -/
lemma psi_branch_div {C S H X : ℝ} (hC : 0 < C) (h : C * (S - C) + (1 + C + S - H) ≤ C * X) :
    (C * (S - C) + (1 + C + S - H)) / C ≤ X := by
  rw [div_le_iff₀ hC]; linarith

lemma cr_self (a : ℝ × ℝ) : cr a a = 0 := by unfold cr; ring
lemma cr_e0 (a : ℝ × ℝ) : cr a ((1, 0) : ℝ × ℝ) = -a.2 := by unfold cr; simp
lemma cr_e90 (a : ℝ × ℝ) : cr a ((0, 1) : ℝ × ℝ) = a.1 := by unfold cr; simp

lemma alFr_nonneg {ε : Bool} {C S : ℝ} (hC : 0 ≤ C) (hS : 0 ≤ S) :
    0 ≤ (alFr ε C S).1 ∧ 0 ≤ (alFr ε C S).2 := by
  cases ε <;> simp [alFr, hC, hS]

/-- The half-angle frame is a unit vector. -/
lemma half_unit (u : ℝ) : ((1 - u ^ 2) / (1 + u ^ 2)) ^ 2 + (2 * u / (1 + u ^ 2)) ^ 2 = 1 := by
  have : 0 < 1 + u ^ 2 := by positivity
  field_simp; ring

/-- In the frontier branch, `u < 1`. -/
lemma half_lt_one {u : ℝ} (h : 0 < (1 - u ^ 2) / (1 + u ^ 2)) (hu : 0 ≤ u) : u < 1 := by
  have : 0 < 1 - u ^ 2 := by
    have h2 : 0 < 1 + u ^ 2 := by positivity
    exact (div_pos_iff_of_pos_right h2).1 h
  nlinarith

end SquarePacking
