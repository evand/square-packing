  have key : 0 ≤ (C*t' + C - H*t/2 - H*t'/2 + S*t + S - 1) * (C * S) := by linear_combination hP + (H*S/2 - S^2) * ht + (-C^2 + C*H/2) * ht'
  have hF := nonneg_of_mul_nonneg_left key (mul_pos hCp hSp)
  linarith

end SquarePacking
